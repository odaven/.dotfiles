#!/usr/bin/env zsh

set -euo pipefail

source "$HOME/.dotfiles/config/zsh/env.zsh"

dirs=(
  "$XDG_CACHE_HOME"
  "$XDG_CACHE_HOME/python"
  "$XDG_CONFIG_HOME"
  "$XDG_BIN_HOME"
  "$HOME/.local/opt"
  "$XDG_DATA_HOME"
  "$XDG_DATA_HOME/python"
  "$XDG_STATE_HOME"
  "$XDG_STATE_HOME/less"
  "$XDG_STATE_HOME/mysql"
  "$XDG_STATE_HOME/node"
  "$XDG_STATE_HOME/python"
  "$XDG_STATE_HOME/sqlite"
  "$XDG_STATE_HOME/zsh"
)

mkdir -p "${dirs[@]}"
